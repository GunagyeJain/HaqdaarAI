# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.
#
# INVARIANT 2: the typed path works with every AI key below left blank.
# Only the voice path needs them. Leaving them unset is a supported mode,
# not a broken setup — the degradation test in tests/e2e relies on it.
# ─────────────────────────────────────────────────────────────────────────────

# Database — matches docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://haqdaar:haqdaar@localhost:5433/haqdaar"

# ── Speech-to-text / text-to-speech (optional) ───────────────────────────────
# Sarvam AI — Indic-native STT/TTS. https://dashboard.sarvam.ai
# Unset -> falls back to browser SpeechRecognition/SpeechSynthesis, then typed form.
SARVAM_API_KEY=""

# ── LLM extraction (optional) ────────────────────────────────────────────────
# Groq. https://console.groq.com/keys
# Used for transcript -> structured JSON ONLY. Never for eligibility decisions.
# Unset -> voice input is disabled; the typed form remains fully functional.
GROQ_API_KEY=""
GROQ_MODEL=""

# ── Provider selection (config, not code — see docs/ARCHITECTURE.md) ─────────
STT_PROVIDER="sarvam"    # sarvam | browser | none
TTS_PROVIDER="sarvam"    # sarvam | browser | none
LLM_PROVIDER="groq"      # groq | mock | none

# Hard timeout (ms) on any AI provider call before falling back.
PROVIDER_TIMEOUT_MS="4000"

# ── Scraper ──────────────────────────────────────────────────────────────────
SCRAPE_TARGET_URL="https://www.myscheme.gov.in"
SCRAPE_MIN_SCHEMES="150"     # scraper exits non-zero below this floor
SCRAPE_DELAY_MS="1200"       # politeness delay between pages
